{
  "name": "restruct/silverstripe-cookiebar",
  "description": "Cookie notice bar set up in the CMS: your text, an Accept button, a link to your cookie page, and scripts that run before and after consent (eg Google Consent Mode)",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "keywords": [
    "silverstripe",
    "silverstripe-module",
    "silverstripe-cms",
    "cookies",
    "cookie-banner",
    "cookie-consent",
    "consent-mode",
    "gdpr"
  ],
  "authors": [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl"
    }
  ],
  "require": {
    "php": "^8.1",
    "silverstripe/framework": "^5 || ^6",
    "silverstripe/cms": "^5 || ^6",
    "silverstripe/siteconfig": "^5 || ^6",
    "silverstripe/asset-admin": "^2 || ^3",
    "silverstripe/vendor-plugin": "^2 || ^3"
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "suggest": {
    "silverstripe/htmleditor-tinymce": "Silverstripe 6: makes the Cookie bar Content field a WYSIWYG editor (TinyMCE is a separate module there)"
  },
  "extra": {
    "expose": [
      "client/dist/css",
      "client/dist/js"
    ],
    "installer-name": "cookie-bar"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\CookieBar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\CookieBar\\Tests\\": "tests/"
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
