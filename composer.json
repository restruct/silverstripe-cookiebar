{
  "name": "restruct/silverstripe-cookiebar",
  "description": "Drop-in configurable notice about cookies",
  "type": "silverstripe-vendormodule",
  "license": "MIT",
  "keywords": [
    "silverstripe",
    "cookies"
  ],
  "authors": [
    {
      "name": "Restruct",
      "email": "dev@restruct.nl",
      "homepage": "https://restruct.nl"
    }
  ],
  "require": {
    "php": "^8.1",
    "silverstripe/framework": "^5 || ^6",
    "silverstripe/cms": "^5 || ^6",
    "silverstripe/siteconfig": "^5 || ^6",
    "silverstripe/asset-admin": "^2 || ^3",
    "silverstripe/vendor-plugin": "^2 || ^3"
  },
  "require-dev": {
    "silverstripe/recipe-testing": "^3 || ^4"
  },
  "extra": {
    "expose": [
      "client/dist/css",
      "client/dist/js"
    ],
    "installer-name": "cookie-bar"
  },
  "autoload": {
    "psr-4": {
      "Restruct\\CookieBar\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Restruct\\CookieBar\\Tests\\": "tests/"
    }
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/restruct"
    }
  ]
}
